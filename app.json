{
  "expo": {
    "name": "RecipeExtract",
    "slug": "recipe-extract",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./mobile/assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "recipeextract",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recipeextract.app"
    },
    "android": {
      "package": "com.recipeextract.app",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#14110E",
        "foregroundImage": "./mobile/assets/android-icon-foreground.png",
        "backgroundImage": "./mobile/assets/android-icon-background.png",
        "monochromeImage": "./mobile/assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "recipeextract",
              "host": "import"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            { "mimeType": "text/plain" },
            { "mimeType": "text/uri-list" }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./mobile/assets/favicon.png"
    },
    "plugins": ["expo-sharing"],
    "extra": {
      "eas": {
        "projectId": "848665db-eb82-44cb-9dcb-9b640fb7239a"
      }
    },
    "owner": "jleonanderson12"
  }
}
