{
  "expo": {
    "name": "Pluck",
    "slug": "recipe-extract",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/owl-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/owl-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F0E4"
    },
    "scheme": "recipeextract",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recipeextract.app"
    },
    "android": {
      "package": "com.recipeextract.app",
      "versionCode": 11,
      "usesCleartextTraffic": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0E1519",
        "foregroundImage": "./assets/owl-logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/owl-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "recipeextract",
              "host": "import"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "text/uri-list"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/owl-logo.png"
    },
    "plugins": [
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          }
        }
      ],
      "expo-sharing",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "848665db-eb82-44cb-9dcb-9b640fb7239a"
      },
      "apiUrl": "https://recipeextract-production.up.railway.app",
      "privacyUrl": "https://recipeextract-production.up.railway.app/privacy.html",
      "testersUrl": "https://recipeextract-production.up.railway.app/testers.html"
    },
    "owner": "jleonanderson12"
  }
}
